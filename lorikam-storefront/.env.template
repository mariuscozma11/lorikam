# Storefront environment.
#
# BUILD vs RUNTIME matters here. Everything prefixed NEXT_PUBLIC_ is inlined
# into the client bundle by `next build`, so changing one needs a rebuild, not
# just a restart. check-env-variables.js (run from next.config.js) aborts the
# build if a REQUIRED var below is missing, so nothing silently falls back to
# localhost in production.

# --- REQUIRED (build + runtime) -------------------------------------------

# Public URL of the Medusa backend. Used server-side by every data fetch and,
# at build time, by next.config.js to allow next/image to load uploaded files
# from that host. No trailing slash.
MEDUSA_BACKEND_URL=https://api.lorikam.com

# Publishable API key from the backend admin (Settings → Publishable API Keys).
# Scopes the storefront to a sales channel; without it /store requests 401.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Public URL of this storefront. Feeds metadataBase, canonicals, OG tags and
# src/app/sitemap.ts, so a wrong value ships wrong links. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://lorikam.com

# --- OPTIONAL (build + runtime) -------------------------------------------

# Region/country code the middleware redirects to when the URL has none, and
# the region sitemap.ts enumerates. Defaults to "ro".
NEXT_PUBLIC_DEFAULT_REGION=ro

# Stripe publishable key. Without it the Stripe payment step refuses to render
# (the card form shows an error), but the rest of the store works.
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud payments — alternatives to NEXT_PUBLIC_STRIPE_KEY, only needed
# when payments run through Medusa Cloud instead of your own Stripe account.
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# --- OPTIONAL (build time only) -------------------------------------------

# Medusa Cloud S3 bucket serving product images. Both must be set together;
# they are read by next.config.js to whitelist that host for next/image, so
# they have no effect unless the build sees them.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
