# CORS — set to your real storefront/admin origins in production (comma-separated, no trailing slash)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Database / Redis
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

# Secrets — MUST be strong random values in production (e.g. `openssl rand -base64 48`)
# The server refuses to boot in production if these are unset or left as "supersecret".
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend). Without RESEND_API_KEY the app uses the local console provider.
# Get a key at https://resend.com. RESEND_FROM must be a verified domain sender,
# e.g. "Lorikam <comenzi@lorikam.ro>".
RESEND_API_KEY=
RESEND_FROM=Lorikam <onboarding@resend.dev>

# Public URL of this backend. Used to build URLs for uploaded images
# (file-local provider). Must be the final public domain in production —
# these URLs are persisted in the DB. Leave unset locally (defaults to
# http://localhost:9000).
BACKEND_PUBLIC_URL=

# Port the server listens on. Medusa defaults to 9000. On Railway this is
# pinned to 9000 to match EXPOSE and the domain's target port.
PORT=9000
